# Fastfile
# Documentation: https://github.com/fastlane/fastlane/tree/master/fastlane/docs

fastlane_version "2.230.0"

platform :android do

  desc "DEV → Build arm64-v8a APK and send to Telegram"
  lane :telegram_apk do
    build_number = Time.now.to_i
    build_name = "1.0.#{build_number}"

    # Build the APK
    sh "flutter build apk --release --split-per-abi --build-name=#{build_name} --build-number=#{build_number}"

    # Path to APK
    apk_path = File.expand_path("../../build/app/outputs/flutter-apk/app-arm64-v8a-release.apk")

    unless File.exist?(apk_path)
      UI.user_error!("🚨 arm64-v8a APK not found at #{apk_path}")
    end

    # Send to Telegram
    telegram(
      token: ENV['TELEGRAM_BOT_TOKEN'],
      chat_id: ENV['TELEGRAM_CHAT_ID'],
      text: "🧪 *DEV Build Ready!* \n\n" \
            "📦 *Project:* #{ENV['PROJECT_NAME']} \n" \
            "🧠 *ABI:* arm64-v8a \n" \
            "🔢 *Build Name:* #{build_name} \n" \
            "📅 *Timestamp:* #{Time.now.strftime('%Y-%m-%d %H:%M:%S')} \n\n" \
            "⚡ Tested on local dev branch. APK ready to be installed!",
      file: apk_path,
      mime_type: "application/vnd.android.package-archive"
    )
  end

  desc "MAIN → Build AAB and send to Telegram"
  lane :telegram_aab do
    build_number = Time.now.to_i
    build_name = "1.0.#{build_number}"

    # Build the AAB
    sh "flutter build appbundle --release --build-name=#{build_name} --build-number=#{build_number}"

    # Path to AAB
    aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab")

    unless File.exist?(aab_path)
      UI.user_error!("🚨 AAB not found at #{aab_path}")
    end

    # Send to Telegram
    telegram(
      token: ENV['TELEGRAM_BOT_TOKEN'],
      chat_id: ENV['TELEGRAM_CHAT_ID'],
      text: "🚀 *PRODUCTION Build Ready!* \n\n" \
            "📦 *Project:* #{ENV['PROJECT_NAME']} \n" \
            "📄 *Format:* AAB \n" \
            "🔢 *Build Name:* #{build_name} \n" \
            "📅 *Timestamp:* #{Time.now.strftime('%Y-%m-%d %H:%M:%S')} \n\n" \
            "🎯 Production ready! Upload to Play Store or share with testers.",
      file: aab_path,
      mime_type: "application/octet-stream"
    )
  end

end
