platform :android do
  desc "DEV → Build AAB and upload to Internal Testing track"
  lane :internal_test do

    # Build the AAB
    sh "flutter build appbundle --release"

    aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab")

    unless File.exist?(aab_path)
      UI.user_error!("🚨 AAB not found at #{aab_path}")
    end

    # Upload to Internal Testing track
    supply(
      json_key: "play_store_key.json", # Base64-decoded JSON service account
      package_name: "com.wolfdev.hojaty",   # e.g., com.wolf.hojaty
      track: "internal",
      aab: aab_path,
    )

    UI.message("✅ Internal Testing build uploaded successfully!")
  end
end
