platform :android do
  desc "DEV → Build AAB and upload directly to Closed Testing review"
  lane :closed_test do

    api_keys_path = File.expand_path("../../api_keys.json")
    symbols_dir = File.expand_path("../../build/app/outputs/symbols")

    unless File.exist?(api_keys_path)
      UI.user_error!("🚨 api_keys.json not found at #{api_keys_path}! Make sure it exists locally or is generated by CI.")
    end

    # Build the AAB with injected API keys and code obfuscation
    sh "flutter build appbundle --release --dart-define-from-file=#{api_keys_path} --obfuscate --split-debug-info=#{symbols_dir}"

    aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab")

    unless File.exist?(aab_path)
      UI.user_error!("🚨 AAB not found at #{aab_path}")
    end

    release_status = ENV.fetch("RELEASE_STATUS", "completed")

    # Upload to Closed Testing track and send for review
    supply(
      json_key: "play_store_key.json",
      package_name: "com.wolfdev.hojaty",
      # لو التراك بتاعك هو الافتراضي سيبه "alpha"، لو اسمه "Testers" اكتب "Testers"
      track: "testers", 
      release_status: release_status,
      changes_not_sent_for_review: false, # false عشان يبعت للمراجعة أوتوماتيك
      aab: aab_path,
    )

    UI.message("✅ Closed Testing build uploaded and sent for review as #{release_status}!")
  end
end
